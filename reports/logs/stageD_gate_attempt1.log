    @pytest.mark.criterion("R3")
    def test_R3_censoring_awareness():
        obs, ora, tr, va, te = _data(0.1, 0.3)
        grid = np.linspace(0, ora.t_max, 101)
        S_true = ora.subset(te).survival(grid)
        errs = {}
        cs = []
